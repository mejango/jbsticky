{
  "name": "@bananapus/sticky-v6",
  "version": "1.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mejango/jbsticky.git"
  },
  "files": [
    "DEPLOYMENT.md",
    "deployments/",
    "foundry.toml",
    "remappings.txt",
    "script/",
    "src/"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "forge test",
    "coverage": "forge coverage --match-path \"./src/*.sol\" --report lcov --report summary",
    "deploy:mainnets": "set -a; if [ -f ./.env ]; then . ./.env || exit; fi; set +a; FOUNDRY_PROFILE=deploy sphinx propose ./script/Deploy.s.sol --networks mainnets",
    "deploy:testnets": "set -a; if [ -f ./.env ]; then . ./.env || exit; fi; set +a; FOUNDRY_PROFILE=deploy sphinx propose ./script/Deploy.s.sol --networks testnets",
    "deploy:rehearse": "FOUNDRY_PROFILE=deploy forge script script/Rehearse.s.sol:Rehearse",
    "deploy:verify": "FOUNDRY_PROFILE=deploy forge script script/Verify.s.sol:Verify",
    "test:deployment": "forge test --match-path \"test/deployment/*.t.sol\" && node --test test/deployment/config.test.cjs"
  },
  "dependencies": {
    "@bananapus/721-hook-v6": "^1.0.0",
    "@bananapus/buyback-hook-v6": "^1.3.1",
    "@bananapus/core-v6": "file:../../nana-core-v6",
    "@bananapus/distributor-v6": "file:../../nana-distributor-v6",
    "@bananapus/ownable-v6": "^1.0.0",
    "@bananapus/permission-ids-v6": "^1.0.0",
    "@bananapus/suckers-v6": "^1.1.2",
    "@chainlink/contracts": "1.5.0",
    "@openzeppelin/contracts": "5.6.1",
    "@prb/math": "4.1.2",
    "@rev-net/core-v6": "^1.0.0",
    "@uniswap/permit2": "github:Uniswap/permit2#cc56ad0f3439c502c246fc5cfcc3db92bb8b7219"
  },
  "devDependencies": {
    "@sphinx-labs/plugins": "0.33.3"
  }
}

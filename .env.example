# Alternatively, export STICKY_ENV_FILE=../../deploy-all-v6/.env before deployment or test:fork commands.
# RPC endpoints for the intended deployment group.
# test:fork requires Ethereum and Base mainnet endpoints with archive access to the documented pinned blocks.
RPC_ETHEREUM_MAINNET=
RPC_OPTIMISM_MAINNET=
RPC_BASE_MAINNET=
RPC_ARBITRUM_MAINNET=
RPC_ETHEREUM_SEPOLIA=
RPC_OPTIMISM_SEPOLIA=
RPC_BASE_SEPOLIA=
RPC_ARBITRUM_SEPOLIA=

# Existing Sphinx organization credentials (required only for proposals).
SPHINX_MANAGED_BASE_URL=
SPHINX_ORG_ID=
SPHINX_API_KEY=

# Etherscan v2 key; one key verifies sources and reads creation receipts on every chain (deploy:artifacts:*).
ETHERSCAN_API_KEY=

# Optional: directory containing the core's flat per-network deployment folders.
# NANA_CORE_DEPLOYMENT_PATH=node_modules/@bananapus/core-v6/deployments
# STICKY_REVISION=<reviewed git commit>
# STICKY_LOCAL_DEMO=true  # Disposable local demo only; never production.

# Railway env vars for the Sticky webclient. build-config.py reads these and writes config.js.
# Shared-service names match juicebox.money so values copy straight across.

# Server port (Railway also wants this in the domain dialog).
PORT=8080

# RPCs — one Dwellir key fans out to every chain (same key/host map as juicebox.money).
NEXT_PUBLIC_DWELLIR_API_KEY=
# Or set explicit per-chain URLs instead of (or on top of) the Dwellir key:
# STICKY_RPC_1=https://…
# STICKY_RPC_8453=https://…
STICKY_ENS_RPC=https://ethereum-rpc.publicnode.com

# Which chains to serve, and the default. Comma-separated chain ids.
STICKY_CHAINS=11155111
# STICKY_DEFAULT_CHAIN=11155111

# Contract addresses from the deploy (one address across chains for a deterministic deploy;
# use STICKY_DEPLOYER_<chainId> to override a single chain).
STICKY_DEPLOYER=
STICKY_DISTRIBUTOR=
STICKY_POCKETS=
STICKY_AUTOSTICK_ADAPTER=
STICKY_PROJECT_ID=
STICKY_FROM_BLOCK=earliest

# Bendystraw (indexer) — threaded into config for when the client queries it.
NEXT_PUBLIC_BENDYSTRAW_URL=https://bendystraw.up.railway.app
NEXT_PUBLIC_TESTNET_BENDYSTRAW_URL=https://testnet.bendystraw.xyz

# Para (wallet) — threaded into config for when the client wires it.
NEXT_PUBLIC_PARA_API_KEY=
NEXT_PUBLIC_PARA_ENV=PROD

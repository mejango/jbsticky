# build-config.py writes PUBLIC config.js. Every configured value is readable by
# visitors. Use browser-restricted RPC keys; never put private server keys here.
# Load these variables into your shell or Railway service; Python does not load .env.
PORT=8080

# Live is the default. A live build fails until its default network has a deployer.
# Set true only for the explicit read-only fixture demo.
STICKY_DEMO=false
STICKY_DEFAULT_CHAIN=1

# A Dwellir browser key supplies RPCs for all 8 networks. Explicit per-chain URLs win.
NEXT_PUBLIC_DWELLIR_API_KEY=
# STICKY_RPC_1=https://ethereum-rpc.publicnode.com
# STICKY_RPC_8453=https://base-mainnet.example/rpc
# STICKY_ENS_RPC=https://ethereum-rpc.publicnode.com

# Set global addresses only if the same deployment is verified on every network.
# Otherwise use STICKY_DEPLOYER_<chainId>, STICKY_DISTRIBUTOR_<chainId>,
# STICKY_REWARD_RECEIVER_FACTORY_<chainId>, and STICKY_AUTOSTICK_ADAPTER_<chainId>.
STICKY_DEPLOYER=
STICKY_DISTRIBUTOR=
STICKY_REWARD_RECEIVER_FACTORY=
STICKY_AUTOSTICK_ADAPTER=
# STICKY_DEPLOYER_1=0x...
# STICKY_DEPLOYER_8453=0x...

# Use each real deployment's block to keep discovery scans bounded.
STICKY_FROM_BLOCK=earliest
# STICKY_FROM_BLOCK_1=...
# STICKY_FROM_BLOCK_8453=...
STICKY_PROJECT_ID=

# Prepaid Relayr API. All payment choices come from an actual validated quote.
STICKY_RELAYR_URL=https://api.relayr.ba5ed.com

# Juicebox Center lists each launch (a signed project intent). HTTPS origin only.
STICKY_CENTER_URL=https://juicebox.center

# Indexer endpoints are public; live transaction evidence comes from chain RPCs.
NEXT_PUBLIC_BENDYSTRAW_URL=https://bendystraw.up.railway.app
NEXT_PUBLIC_TESTNET_BENDYSTRAW_URL=https://testnet.bendystraw.xyz

# Sign in with Signa (passkey accounts). Enable only once Signa admits this site's origin
# with its /center/callback. Over HTTPS the issuer and audience must be exactly these;
# a local Signa runs on http://localhost. The manifest pins match Homerun's.
STICKY_CENTER_WALLET_ENABLED=false
STICKY_CENTER_WALLET_ISSUER=https://signa.center
STICKY_CENTER_WALLET_AUDIENCE=https://api.signa.center
STICKY_CENTER_WALLET_MANIFEST_ID=
STICKY_CENTER_WALLET_MANIFEST_REVISION=
# EntryPoint prefund ceiling in wei; excludes separate Base data fees.
STICKY_CENTER_WALLET_MAXIMUM_NETWORK_FEE_WEI=
